+/*
+ * Offset auto-detection for PLAIN dm-crypt containers hidden inside a cover file.
+ *
+ * A container created by createVolumeInExistingFIle always satisfies two properties
+ * we can exploit to keep the search space small and bounded:
+ *
+ * 1. the requested container size is a whole number of MB, and the cover file is grown
+ *    in 1024 byte chunks, so  fileSize = offset + n*MB + r  with  0 <= r < 1024
+ *
+ * 2. the offset is the original cover file size rounded UP to a whole KB, MB or GB
+ *    depending on how big that file was, so the offset is always aligned to its tier
+ *
+ * Together these bound the candidate list at roughly 2000 entries no matter how big
+ * the cover file is. Candidates produced from container sizes people actually pick
+ * are probed first so the common case resolves in a couple of seconds.
+ */
+namespace{
+
+class offsetCandidates
+{
+public:
+	static QVector< qint64 > build( qint64 fileSize )
+	{
+		QVector< qint64 > out ;
+		QSet< qint64 > seen ;
+
+		auto tierAligned = []( qint64 off ){
+
+			if( off >= GB ){
+
+				return off % GB == 0 ;
+
+			}else if( off >= MB ){
+
+				return off % MB == 0 ;
+
+			}else if( off >= KB ){
+
+				return off % KB == 0 ;
+			}else{
+				return false ;
+			}
+		} ;
+
+		auto add = [ & ]( qint64 containerSizeMB ){
+
+			auto raw = fileSize - containerSizeMB * MB ;
+
+			if( raw <= 0 ){
+
+				return ;
+			}
+
+			auto off = ( raw / KB ) * KB ;
+
+			if( off <= 0 || !tierAligned( off ) || seen.contains( off ) ){
+
+				return ;
+			}
+
+			seen.insert( off ) ;
+			out.append( off ) ;
+		} ;
+
+		for( auto it : commonSizes() ){
+
+			add( it ) ;
+		}
+
+		auto maxC = fileSize / MB ;
+
+		for( qint64 c = 1 ; c <= maxC ; c++ ){
+
+			add( c ) ;
+		}
+
+		/*
+		 * The two loops above only reach offsets where "file size minus offset" is a
+		 * whole number of MB. That holds for a cover file written in one pass, but it
+		 * breaks for every container but the newest once containers are stacked, so
+		 * finish with the complete set of offsets the create dialog can ever produce:
+		 * the host size rounded up to its own KB, MB or GB tier.
+		 */
+		auto addOffset = [ & ]( qint64 off ){
+
+			if( off > 0 && off < fileSize && !seen.contains( off ) ){
+
+				seen.insert( off ) ;
+				out.append( off ) ;
+			}
+		} ;
+
+		for( qint64 k = 1 ; k <= 1024 ; k++ ){
+
+			addOffset( k * KB ) ;
+		}
+
+		for( qint64 k = 1 ; k <= 1024 ; k++ ){
+
+			addOffset( k * MB ) ;
+		}
+
+		for( qint64 k = 1 ; k * GB < fileSize ; k++ ){
+
+			addOffset( k * GB ) ;
+		}
+
+		return out ;
+	}
+private:
+	static const qint64 KB = 1024 ;
+	static const qint64 MB = 1024 * 1024 ;
+	static const qint64 GB = 1024 * 1024 * 1024 ;
+
+	static QVector< qint64 > commonSizes()
+	{
+		return { 1,2,4,5,8,10,16,20,25,32,40,50,64,75,100,128,150,200,250,256,300,400,500,512,
+			 750,1000,1024,1500,2000,2048,3000,4000,4096,5000,6000,8000,8192,10000,
+			 16000,16384,20000,25000,32000,32768,50000,51200,65536,100000,102400 } ;
+	}
+} ;
+
+}
+
+void passwordDialog::detectOffset()
+{
+	if( m_detecting ){
+
+		m_detectCancel = true ;
+		return ;
+	}
+
+	auto volumePath = m_ui->OpenVolumePath->text() ;
+
+	if( volumePath.isEmpty() ){
+
+		return m_label.show( tr( "Set a path to the cover file first" ) ) ;
+	}
+
+	QFileInfo fileInfo( volumePath ) ;
+
+	if( !fileInfo.isFile() ){
+
+		return m_label.show( tr( "Offset detection only works on a container hosted in a file" ) ) ;
+	}
+
+	auto key = m_ui->PassPhraseField->text() ;
+
+	if( key.isEmpty() ){
+
+		return m_label.show( tr( "Enter the volume password first, it is required to detect the offset" ) ) ;
+	}
+
+	auto candidates = offsetCandidates::build( fileInfo.size() ) ;
+
+	if( candidates.isEmpty() ){
+
+		return m_label.show( tr( "This file is too small to hold a hidden container" ) ) ;
+	}
+
+	auto cipher = m_plainDmCryptProperty ;
+
+	auto exePath = QString( ZULUCRYPTzuluCrypt ) ;
+
+	auto device = volumePath ;
+	device.replace( "\"","\"\"\"" ) ;
+
+	m_detecting    = true ;
+	m_detectCancel = false ;
+	m_detectDone   = 0 ;
+	m_detectTotal  = candidates.size() ;
+
+	this->disableAll() ;
+
+	m_ui->pbDetectOffset->setEnabled( true ) ;
+	m_ui->pbDetectOffset->setText( tr( "Stop" ) ) ;
+
+	auto progress = new QTimer( this ) ;
+
+	connect( progress,&QTimer::timeout,this,[ this ](){
+
+		auto done = m_detectDone.load() ;
+
+		m_label.show( tr( "Searching for the container ... %1 of %2 offsets tried" )
+			      .arg( QString::number( done ),QString::number( m_detectTotal ) ) ) ;
+	} ) ;
+
+	progress->start( 200 ) ;
+
+	qint64 found = -1 ;
+
+	bool alreadyOpen = false ;
+	bool mountPointBlocked = false ;
+
+	/*
+	 * A probe mount point left behind by a previous, interrupted search makes every
+	 * later probe fail with "could not create mount point". That error must never be
+	 * read as "wrong key", or a whole search silently reports nothing found. Use a
+	 * mount name unique to this run and stop with a real explanation if it still happens.
+	 */
+	auto probeName = "zuluCrypt-offset-probe-" +
+			 QString::number( QDateTime::currentMSecsSinceEpoch() % 1000000 ) ;
+
+	Task::await( [ & ](){
+
+		auto closeVolume = [ & ](){
+
+			auto close = QString( "%1 -q -d \"%2\"" ).arg( exePath,device ) ;
+
+			utility::Task::run( utility::appendUserUID( close ) ).await() ;
+		} ;
+
+		for( auto offset : candidates ){
+
+			if( m_detectCancel.load() ){
+
+				break ;
+			}
+
+			auto keyPath = utility::keyPath() ;
+
+			utility::keySend( keyPath,key ) ;
+
+			auto exe = QString( "%1 -o -d \"%2\" -m \"%3\" -e ro -t %4.%5b -f %6" )
+				   .arg( exePath,
+					 device,
+					 probeName,
+					 cipher,
+					 QString::number( offset ),
+					 keyPath ) ;
+
+			auto r = utility::Task::run( utility::appendUserUID( exe ) ).await() ;
+
+			m_detectDone += 1 ;
+
+			auto output = QString( r.stdOut() + r.stdError() ) ;
+
+			/*
+			 * Every probe would fail the same way if a mapper for this device is
+			 * already open, so say so instead of reporting a fruitless search.
+			 */
+			if( output.contains( "opened mapper" ) ){
+
+				alreadyOpen = true ;
+				break ;
+			}
+
+			if( output.contains( "mount point" ) ){
+
+				mountPointBlocked = true ;
+				break ;
+			}
+
+			if( r.success() ){
+
+				found = offset ;
+
+				closeVolume() ;
+
+				break ;
+			}
+		}
+	} ) ;
+
+	progress->stop() ;
+	progress->deleteLater() ;
+
+	m_detecting = false ;
+
+	m_ui->pbDetectOffset->setText( tr( "Detect" ) ) ;
+
+	this->enableAll() ;
+
+	if( found >= 0 ){
+
+		m_ui->lineEditVolumeProperty->setText( QString::number( found ) + "b" ) ;
+
+		m_label.show( tr( "Container found at offset %1 bytes. Write this number down, "
+				  "it cannot be recovered from the volume itself." )
+			      .arg( QString::number( found ) ) ) ;
+
+	}else if( alreadyOpen ){
+
+		m_label.show( tr( "This volume is already unlocked, close it before detecting the offset" ) ) ;
+
+	}else if( mountPointBlocked ){
+
+		m_label.show( tr( "Could not create a mount point to test with, so the search was "
+				  "stopped rather than wrongly reporting nothing found. Close any "
+				  "open volume and try again." ) ) ;
+
+	}else if( m_detectCancel.load() ){
+
+		m_label.show( tr( "Offset detection stopped" ) ) ;
+	}else{
+		m_label.show( tr( "No container found. The password or the encryption option "
+				  "may be wrong, or this file holds no hidden container." ) ) ;
+	}
+}
