 		m_veraCryptVolume = false ;
 		m_ui->pushButtonLuksExternalHeaderPath->setEnabled( false ) ;
-		m_ui->lineEditVolumeProperty->setEchoMode( QLineEdit::Password ) ;
+
+		/*
+		 * The offset is not a secret and masking it only makes this field
+		 * impossible to proof read, so show it and say what it wants.
+		 */
+		m_ui->lineEditVolumeProperty->setEchoMode( QLineEdit::Normal ) ;
+
+		m_ui->lineEditVolumeProperty->setPlaceholderText( tr( "eg 87040b, or click Detect" ) ) ;
 	}
 
+	m_ui->pbDetectOffset->setVisible( e == 3 ) ;
+
 	utility::defaultUnlockingVolumeType( e ) ;
 }
 
